  m_Script: {fileID: 11500000, guid: 28ec8b4c43df9884dab1e56106bf74dc, type: 3}
  m_Name: Run1_Ren_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerProfile: {fileID: 11400000, guid: f7c1a2881e632cd4394dcdf4ba856751, type: 2}
    textOptions:
    - It seems, you have acquainted yourself with Milo. He'll be your faithful companion
      throughout your journey.
  - speakerProfile: {fileID: 11400000, guid: f7c1a2881e632cd4394dcdf4ba856751, type: 2}
    textOptions:
    - 'Your first trial was harsh, although you managed to retain Ash, the souls
      of the invaders you fought off. '
  - speakerProfile: {fileID: 11400000, guid: f7c1a2881e632cd4394dcdf4ba856751, type: 2}
    textOptions:
    - You may trade your harvested Ash here. I shall grant you a better swing, if
      the newfound memories of Atlas permit me to.
