// Blood splatter lying on the ground (URP, alpha blended quad).
// The splat texture is generated by PlayerHitFX (R = blood thickness, A = shape).
//   - thick blood is darker and richer, thin edges are lighter
//   - a thin wet shine band on the thick parts
//   - slowly dries (darkens) and fades out
// Runtime values (_MainTex, _Fade, _Dry) are set by PlayerHitFX.
Shader "VFX/BloodDecal"
{
    Properties
    {
        _MainTex ("Splat (R = thickness, A = mask)", 2D) = "white" {}
        _ColorCenter ("Thick Blood Color", Color) = (0.42, 0.01, 0.03, 1)
        _ColorEdge ("Thin Blood Color", Color) = (0.22, 0.0, 0.02, 1)
        _Gloss ("Wet Shine", Range(0, 1)) = 0.6

        [HideInInspector] _Fade ("Fade", Float) = 1
        [HideInInspector] _Dry ("Dry", Float) = 0
    }

    SubShader
    {
        Tags
        {
            "RenderType" = "Transparent"
            "Queue" = "Transparent-10"
            "RenderPipeline" = "UniversalPipeline"
            "IgnoreProjector" = "True"
        }

        Pass
        {
            Name "BloodDecal"
            Blend SrcAlpha OneMinusSrcAlpha
            ZWrite Off
            ZTest LEqual
            Cull Off
            Offset -4, -4   // pulls the decal toward the camera so it wins against grass and uneven ground

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            TEXTURE2D(_MainTex);
            SAMPLER(sampler_MainTex);

            CBUFFER_START(UnityPerMaterial)
                float4 _MainTex_ST;
                half4 _ColorCenter;
                half4 _ColorEdge;
                float _Gloss;
                float _Fade;
                float _Dry;
            CBUFFER_END

            struct Attributes
            {
                float4 positionOS : POSITION;
                float2 uv : TEXCOORD0;
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
            };

            Varyings vert(Attributes IN)
            {
                Varyings OUT;
                OUT.positionCS = TransformObjectToHClip(IN.positionOS.xyz);
                OUT.uv = IN.uv;
                return OUT;
            }

            half4 frag(Varyings IN) : SV_Target
            {
                half4 tex = SAMPLE_TEXTURE2D(_MainTex, sampler_MainTex, IN.uv);
                float thick = tex.r;
                float mask = tex.a;

                half3 col = lerp(_ColorEdge.rgb, _ColorCenter.rgb, thick);

                // wet shine: a soft bright band where the blood is medium-thick, fades away as it dries
                float shine = exp(-pow((thick - 0.5) / 0.12, 2.0)) * 0.35 * _Gloss * (1.0 - _Dry);
                col += shine * half3(0.6, 0.15, 0.15);

                // drying darkens the blood
                col *= lerp(1.0, 0.55, _Dry);

                float alpha = mask * _Fade * _ColorCenter.a;
                return half4(col, alpha);
            }
            ENDHLSL
        }
    }
}
