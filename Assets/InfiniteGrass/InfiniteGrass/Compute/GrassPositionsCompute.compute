#pragma kernel CSGrass
#pragma kernel CSFlower

float _Spacing;
float _DrawDistance;
float _MaxDrawDistance;
float _TextureUpdateThreshold;
float _FullDensityDistance;
float _FadeMinHeightScale;

// Terrain Variables (Grass)
Texture2D<float4> _TerrainSplatmap;
float4 _TerrainPosSize; // x: pos.x, y: pos.z, z: size.x, w: size.z
int _TerrainSplatChannel;

// Terrain Variables (Flower)
Texture2D<float4> _FlowerTerrainSplatmap;
int _FlowerTerrainSplatChannel;

// Terrain Variables (Mixed)
Texture2D<float4> _MixedTerrainSplatmap;
int _MixedTerrainSplatChannel;

int2 _GridStartIndex;
float3 _CameraPosition;
float2 _CenterPos;
float3 _BoundsMin;
float3 _BoundsMax;
float3 _CameraForward;

float4x4 _VPMatrix;

// ---------- Grass cuts (AOE sweep), filled by GrassCutManager ----------
#define MAX_GRASS_CUTS 8
float4 _GrassCutA[MAX_GRASS_CUTS];   // xy = origin XZ, zw = forward direction XZ
float4 _GrassCutB[MAX_GRASS_CUTS];   // x = radius, y = cos(half cone angle), z = age in seconds
float4 _GrassCutTimings;             // x = sweep time, y = stay-cut time, z = regrow time, w = blow time
int _GrassCutCount;
float _GrassCutFlowers;
float _GrassCutJitter;               // ragged leading edge amount (world units)

SamplerState pointClampSampler;
SamplerState linearClampSampler;

Texture2D<float4> _GrassHeightMapRT; 
Texture2D<float> _GrassMaskMapRT;
Texture2D<float> _FlowerMaskMapRT; 

AppendStructuredBuffer<float4> _GrassPositions; // xyz = world position, w = height scale (for edge fading)
AppendStructuredBuffer<float3> _FlowerPositions; 

uint murmurHash3(int input) {
    uint h = abs(input);
    h ^= h >> 16; h *= 0x85ebca6b;
    h ^= h >> 13; h *= 0xc2b2ae3d;
    h ^= h >> 16; return h;
}

float random(int index) { return murmurHash3(index) / 4294967295.0; }

float Remap(float In, float2 InMinMax, float2 OutMinMax) {
    return OutMinMax.x + (In - InMinMax.x) * (OutMinMax.y - OutMinMax.x) / (InMinMax.y - InMinMax.x);
}

float CutRand(float2 p)
{
    return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

// 0 -> 1 over the "blow time", starting the moment the cut front reaches this blade.
float GrassCutProgress(float dist, float2 posXZ, float radius, float age)
{
    float d = dist + (CutRand(posXZ) - 0.5) * _GrassCutJitter;            // ragged edge
    float reach = radius + 0.5 * _GrassCutJitter;                         // distance the front finally reaches
    float eased = saturate(d / reach);
    float tHit = (1.0 - sqrt(1.0 - eased)) * _GrassCutTimings.x;          // front = reach * (1 - (1-t)^2), solved for t
    return saturate((age - tHit) / max(_GrassCutTimings.w, 0.001));
}

// 0 = untouched, 1 = fully cut. Values in between make the blade shorter.
float GrassCutAmount(float2 posXZ)
{
    float amount = 0.0;

    [loop]
    for (int i = 0; i < _GrassCutCount; i++)
    {
        float2 toBlade = posXZ - _GrassCutA[i].xy;
        float dist = length(toBlade);
        float radius = _GrassCutB[i].x;
        if (dist > radius) continue;

        // inside the cone? (soft angular edge, centred on the cone border)
        float cosAngle = dist > 0.001 ? dot(toBlade / dist, _GrassCutA[i].zw) : 1.0;
        float cone = saturate((cosAngle - _GrassCutB[i].y) / 0.1 + 0.5);
        if (cone <= 0.0) continue;

        float age = _GrassCutB[i].z;
        float p = GrassCutProgress(dist, posXZ, radius, age);
        float shrink = smoothstep(0.35, 1.0, p);   // the blade first whips outward (blade shader), then shrinks away

        // after staying cut for a while, the grass grows back
        float regrow = saturate((age - _GrassCutTimings.x - _GrassCutTimings.w - _GrassCutTimings.y) / max(_GrassCutTimings.z, 0.001));
        regrow = regrow * regrow * (3.0 - 2.0 * regrow);

        amount = max(amount, cone * shrink * (1.0 - regrow));
    }

    return amount;
}

[numthreads(8, 8, 1)]
void CSGrass(uint3 id : SV_DispatchThreadID)
{   
    int2 currentIndex = _GridStartIndex + id.xy;
    float2 positionXZ = currentIndex * _Spacing;
    positionXZ += (float2(random(currentIndex.x * 5542 + currentIndex.y), random(currentIndex.y * 9824 + currentIndex.x)) * 2 - 1) * _Spacing;
    
    float2 uv = (positionXZ - _CenterPos) / (_TextureUpdateThreshold + _MaxDrawDistance); uv = uv * 0.5 + 0.5;
    
    float4 heightMap = _GrassHeightMapRT.SampleLevel(pointClampSampler, uv, 0);
    float grassMaskValue = _GrassMaskMapRT.SampleLevel(linearClampSampler, uv, 0).r;
    
    // Calculate Terrain Splatmap UV using World Position
    float2 terrainUV = (positionXZ - _TerrainPosSize.xy) / _TerrainPosSize.zw;

    // Sample Grass Layer
    float4 splatColor = _TerrainSplatmap.SampleLevel(linearClampSampler, terrainUV, 0);
    float grassWeight = splatColor[_TerrainSplatChannel]; 

    // Sample Mixed Layer
    float4 mixedSplatColor = _MixedTerrainSplatmap.SampleLevel(linearClampSampler, terrainUV, 0);
    float mixedWeight = mixedSplatColor[_MixedTerrainSplatChannel];

    // Combine them! Grass spawns if either Grass OR Mixed layer is painted.
    float combinedWeight = saturate(grassWeight + mixedWeight);

    bool inGrassMask = saturate(random(currentIndex.x * 9421 + currentIndex.y) - 0.001) >= grassMaskValue;
    // Instead of a hard cutoff, treat the painted weight as a spawn PROBABILITY.
    // This turns brush falloff into a natural, dithered fade instead of a sharp line.
    bool inTerrainWeight = random(currentIndex.x * 3049 + currentIndex.y * 9311) < combinedWeight;

    if (heightMap.a > 0.99 && heightMap.g > 0.5 && inGrassMask && inTerrainWeight)
    {
        float3 positionWS = float3(positionXZ.x, Remap(heightMap.r, float2(0, 1), float2(_BoundsMin.y, _BoundsMax.y)), positionXZ.y);
        uint d = 1 << uint(floor(length(_CameraPosition - positionWS) / _FullDensityDistance));
        bool insideDensityLevel = murmurHash3(currentIndex.x + currentIndex.y * 7954) % d == 0;
        float4 absPosCS = abs(mul(_VPMatrix, float4(positionWS, 1.0)));

        if (insideDensityLevel && absPosCS.z <= absPosCS.w && absPosCS.y <= absPosCS.w * 2.0 && absPosCS.x <= absPosCS.w * 1.4 && absPosCS.w <= _DrawDistance)
        {
            // Blades near a thin/faded edge (low combinedWeight) grow in shorter instead of popping to full height.
            float heightScale = lerp(_FadeMinHeightScale, 1.0, combinedWeight);

            // AOE grass cut: blades shrink as the sweep passes, then disappear
            float cutAmount = GrassCutAmount(positionXZ);
            heightScale *= (1.0 - cutAmount);
            if (cutAmount < 0.98)
                _GrassPositions.Append(float4(positionWS, heightScale));
        }
    }
}

[numthreads(8, 8, 1)]
void CSFlower(uint3 id : SV_DispatchThreadID)
{   
    int2 currentIndex = _GridStartIndex + id.xy;
    float2 positionXZ = currentIndex * _Spacing;

    float2 toPosXZ = positionXZ - _CameraPosition.xz;
    float dist = length(toPosXZ);

    // Only check culling if the point isn't directly inside the camera
    if (dist > 2.0) 
    {
        // Normalize the camera's forward XZ vector
        float2 camForwardXZ = normalize(_CameraForward.xz);
        
        // Dot product compares the two directions. 
        float dotForward = dot(toPosXZ / dist, camForwardXZ);
        
        // Instantly kill this GPU thread if the point is behind the camera
        if (dotForward < -0.4) return;
    }
    
    positionXZ += (float2(random(currentIndex.x * 5542 + currentIndex.y), random(currentIndex.y * 9824 + currentIndex.x)) * 2 - 1) * _Spacing;
    
    float2 uv = (positionXZ - _CenterPos) / (_TextureUpdateThreshold + _MaxDrawDistance); uv = uv * 0.5 + 0.5;
    
    float4 heightMap = _GrassHeightMapRT.SampleLevel(pointClampSampler, uv, 0);
    float flowerMaskValue = _FlowerMaskMapRT.SampleLevel(linearClampSampler, uv, 0).r;
    bool inFlowerMask = saturate(random(currentIndex.x * 7421 + currentIndex.y) - 0.001) >= flowerMaskValue;

    // Calculate Terrain Splatmap UV
    float2 terrainUV = (positionXZ - _TerrainPosSize.xy) / _TerrainPosSize.zw;
    
    // Sample Flower Layer
    float4 splatColor = _FlowerTerrainSplatmap.SampleLevel(linearClampSampler, terrainUV, 0);
    float flowerWeight = splatColor[_FlowerTerrainSplatChannel];
    
    // Sample Mixed Layer
    float4 mixedSplatColor = _MixedTerrainSplatmap.SampleLevel(linearClampSampler, terrainUV, 0);
    float mixedWeight = mixedSplatColor[_MixedTerrainSplatChannel];
    
    // Combine them! Flowers spawn if either Flower OR Mixed layer is painted.
    float combinedWeight = saturate(flowerWeight + mixedWeight);
    // Same probability-based fade as grass, so flower patches don't cut off sharply either.
    bool inTerrainWeight = random(currentIndex.x * 4177 + currentIndex.y * 6829) < combinedWeight;

    if (heightMap.a > 0.99 && heightMap.b > 0.5 && inFlowerMask && inTerrainWeight)
    {
        float3 positionWS = float3(positionXZ.x, Remap(heightMap.r, float2(0, 1), float2(_BoundsMin.y, _BoundsMax.y)), positionXZ.y);
        uint d = 1 << uint(floor(length(_CameraPosition - positionWS) / _FullDensityDistance));
        bool insideDensityLevel = murmurHash3(currentIndex.x + currentIndex.y * 7954) % d == 0;
        float4 absPosCS = abs(mul(_VPMatrix, float4(positionWS, 1.0)));

        if (insideDensityLevel && absPosCS.z <= absPosCS.w && absPosCS.y <= absPosCS.w * 2.0 && absPosCS.x <= absPosCS.w * 1.4 && absPosCS.w <= _DrawDistance)
        {
            // Flowers can't shrink (no height scale), so they simply disappear when the cut sweep reaches them
            if (_GrassCutFlowers < 0.5 || GrassCutAmount(positionXZ) < 0.5)
                _FlowerPositions.Append(positionWS);
        }
    }
}