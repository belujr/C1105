#pragma kernel CSGrass
#pragma kernel CSFlower

float _Spacing;
float _DrawDistance;
float _MaxDrawDistance;
float _TextureUpdateThreshold;
float _FullDensityDistance;

int2 _GridStartIndex;
float3 _CameraPosition;
float2 _CenterPos;
float3 _BoundsMin;
float3 _BoundsMax;
float3 _CameraForward;

float4x4 _VPMatrix;

SamplerState pointClampSampler;
SamplerState linearClampSampler;

Texture2D<float4> _GrassHeightMapRT; 
Texture2D<float> _GrassMaskMapRT;
Texture2D<float> _FlowerMaskMapRT; 

AppendStructuredBuffer<float3> _GrassPositions;
AppendStructuredBuffer<float3> _FlowerPositions; 

uint murmurHash3(int input) {
    uint h = abs(input);
    h ^= h >> 16; h *= 0x85ebca6b;
    h ^= h >> 13; h *= 0xc2b2ae3d;
    h ^= h >> 16; return h;
}

float random(int index) { return murmurHash3(index) / 4294967295.0; }

float Remap(float In, float2 InMinMax, float2 OutMinMax) {
    return OutMinMax.x + (In - InMinMax.x) * (OutMinMax.y - OutMinMax.x) / (InMinMax.y - InMinMax.x);
}

[numthreads(8, 8, 1)]
void CSGrass(uint3 id : SV_DispatchThreadID)
{   
    int2 currentIndex = _GridStartIndex + id.xy;
    float2 positionXZ = currentIndex * _Spacing;
    positionXZ += (float2(random(currentIndex.x * 5542 + currentIndex.y), random(currentIndex.y * 9824 + currentIndex.x)) * 2 - 1) * _Spacing;
    
    float2 uv = (positionXZ - _CenterPos) / (_TextureUpdateThreshold + _MaxDrawDistance); uv = uv * 0.5 + 0.5;
    
    float4 heightMap = _GrassHeightMapRT.SampleLevel(pointClampSampler, uv, 0);
    float grassMaskValue = _GrassMaskMapRT.SampleLevel(linearClampSampler, uv, 0).r;
    bool inGrassMask = saturate(random(currentIndex.x * 9421 + currentIndex.y) - 0.001) >= grassMaskValue;
    
    if (heightMap.a > 0.99 && heightMap.g > 0.5 && inGrassMask)
    {
        float3 positionWS = float3(positionXZ.x, Remap(heightMap.r, float2(0, 1), float2(_BoundsMin.y, _BoundsMax.y)), positionXZ.y);
        uint d = 1 << uint(floor(length(_CameraPosition - positionWS) / _FullDensityDistance));
        bool insideDensityLevel = murmurHash3(currentIndex.x + currentIndex.y * 7954) % d == 0;
        float4 absPosCS = abs(mul(_VPMatrix, float4(positionWS, 1.0)));

        if (insideDensityLevel && absPosCS.z <= absPosCS.w && absPosCS.y <= absPosCS.w * 2.0 && absPosCS.x <= absPosCS.w * 1.4 && absPosCS.w <= _DrawDistance)
        {
            _GrassPositions.Append(positionWS);
        }
    }
}

[numthreads(8, 8, 1)]
void CSFlower(uint3 id : SV_DispatchThreadID)
{   
    int2 currentIndex = _GridStartIndex + id.xy;
    float2 positionXZ = currentIndex * _Spacing;

    float2 toPosXZ = positionXZ - _CameraPosition.xz;
float dist = length(toPosXZ);

// Only check culling if the point isn't directly inside the camera
if (dist > 2.0) 
{
    // Normalize the camera's forward XZ vector
    float2 camForwardXZ = normalize(_CameraForward.xz);
    
    // Dot product compares the two directions. 
    // A value of -1 is directly behind. -0.4 provides a safe buffer for wide FOV screens.
    float dotForward = dot(toPosXZ / dist, camForwardXZ);
    
    // Instantly kill this GPU thread if the point is behind the camera
    if (dotForward < -0.4) return;
}
    positionXZ += (float2(random(currentIndex.x * 5542 + currentIndex.y), random(currentIndex.y * 9824 + currentIndex.x)) * 2 - 1) * _Spacing;
    
    float2 uv = (positionXZ - _CenterPos) / (_TextureUpdateThreshold + _MaxDrawDistance); uv = uv * 0.5 + 0.5;
    
    float4 heightMap = _GrassHeightMapRT.SampleLevel(pointClampSampler, uv, 0);
    float flowerMaskValue = _FlowerMaskMapRT.SampleLevel(linearClampSampler, uv, 0).r;
    bool inFlowerMask = saturate(random(currentIndex.x * 7421 + currentIndex.y) - 0.001) >= flowerMaskValue;
    
    if (heightMap.a > 0.99 && heightMap.b > 0.5 && inFlowerMask)
    {
        float3 positionWS = float3(positionXZ.x, Remap(heightMap.r, float2(0, 1), float2(_BoundsMin.y, _BoundsMax.y)), positionXZ.y);
        uint d = 1 << uint(floor(length(_CameraPosition - positionWS) / _FullDensityDistance));
        bool insideDensityLevel = murmurHash3(currentIndex.x + currentIndex.y * 7954) % d == 0;
        float4 absPosCS = abs(mul(_VPMatrix, float4(positionWS, 1.0)));

        if (insideDensityLevel && absPosCS.z <= absPosCS.w && absPosCS.y <= absPosCS.w * 2.0 && absPosCS.x <= absPosCS.w * 1.4 && absPosCS.w <= _DrawDistance)
        {
            _FlowerPositions.Append(positionWS);
        }
    }
}