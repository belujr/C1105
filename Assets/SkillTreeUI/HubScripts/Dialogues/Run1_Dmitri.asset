  m_Script: {fileID: 11500000, guid: 28ec8b4c43df9884dab1e56106bf74dc, type: 3}
  m_Name: Run1_Dmitri
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Dmitri
    text: Old man Popatlal got anything new to say? Or is he still the remorseful,
      spiteful grumpy sadsack as always, heh?
  - speakerName: Player
    text: Are you Dmitri?
  - speakerName: Dmitri
    text: No shit Sherlock, you ask me this every time.
  - speakerName: Player
    text: Every time?
  - speakerName: Dmitri
    text: "You\u2019ve died like a 1000 times and I\u2019ve seen 1000 of you being
      created again, and again, out of nothingness."
  - speakerName: Player
    text: What is this place?
  - speakerName: Dmitri
    text: "You\u2019ll figure it out man, I\u2019m tired of answering your questions
      everytime, why can\u2019t you ask me something new? Let\u2019s just get to
      the tutorial, you\u2019ll figure it out."
