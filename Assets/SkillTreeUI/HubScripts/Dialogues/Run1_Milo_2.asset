  m_Script: {fileID: 11500000, guid: 28ec8b4c43df9884dab1e56106bf74dc, type: 3}
  m_Name: Run1_Milo_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerProfile: {fileID: 11400000, guid: 8c997c5ba8fc9524880d72f0429fccbe, type: 2}
    textOptions:
    - Are you Milo?
  - speakerProfile: {fileID: 11400000, guid: 4f6ef4ee3543d2a458da382195631fc9, type: 2}
    textOptions:
    - Why is every version of you more confused than the previous one?
  - speakerProfile: {fileID: 11400000, guid: 8c997c5ba8fc9524880d72f0429fccbe, type: 2}
    textOptions:
    - Every version of me?
  - speakerProfile: {fileID: 11400000, guid: 4f6ef4ee3543d2a458da382195631fc9, type: 2}
    textOptions:
    - A thousand deaths, a thousand fresh bodies. And every single one of you starts
      with that exact same blank stare.
  - speakerProfile: {fileID: 11400000, guid: 8c997c5ba8fc9524880d72f0429fccbe, type: 2}
    textOptions:
    - 'What is this place?

'
  - speakerProfile: {fileID: 11400000, guid: 4f6ef4ee3543d2a458da382195631fc9, type: 2}
    textOptions:
    - 'You''ll figure it out. Come meet Master Ren, you must''ve met him before,
      surely.

'
