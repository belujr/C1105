  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 28ec8b4c43df9884dab1e56106bf74dc, type: 3}
  m_Name: Run1_Popatlal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Popatlal
    text: "You see that corpse there? That\u2019s you. And that will be you every
      time you die. There\u2019s no escape for you. You\u2019re a vessel. You\u2019re
      meant to die. Your life is meaningless. Another copy of you will just be made
      again to fight his battles."
  - speakerName: Popatlal
    text: "Then again, he\u2019s weak. Pathetic. Resurrected from the depths of the
      dead just to help out this moron."
  - speakerName: Popatlal
    text: "Then again, he\u2019s weak. Pathetic. Resurrected from the depths of the
      dead just to help out this moron."
  - speakerName: Popatlal
    text: "I\u2019ve been here for Centuries cleaning after all the mess they cause.
      It is my curse to tend to the dead."
  - speakerName: Popatlal
    text: The man behind you, who summoned you with magic, was the original Caretaker
      of this world. He died Centuries ago and his help is now needed by Janus, the
      current Caretaker of the world.
  - speakerName: Popatlal
    text: "In case you haven\u2019t noticed, there\u2019s an alien invasion happening
      out there. I think you better get going, I sense Dmitri approaching\u2026"
