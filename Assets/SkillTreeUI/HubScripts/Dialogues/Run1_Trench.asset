  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 28ec8b4c43df9884dab1e56106bf74dc, type: 3}
  m_Name: Run1_Trench
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: TRENCH
    speakerSubtitle: Keeper of the Dead
    speakerSprite: {fileID: 21300000, guid: 9f5a86738a49db149a43b8f3e00817b2, type: 3}
    text: "Look at that corpse. That\u2019s you. Every time you die, I haul another
      one of you into the dirt."
  - speakerName: TRENCH
    speakerSubtitle: Keeper of the Dead
    speakerSprite: {fileID: 21300000, guid: 9f5a86738a49db149a43b8f3e00817b2, type: 3}
    text: You're a disposable husk, forged by Atlas, the original Caretaker. He's
      been dead for centuries, yet Janus called on him because he's too weak to fight
      this invasion alone
  - speakerName: TRENCH
    speakerSubtitle: Keeper of the Dead
    speakerSprite: {fileID: 21300000, guid: 9f5a86738a49db149a43b8f3e00817b2, type: 3}
    text: "I\u2019ve spent ages cleaning up their mess. That is my curse. Yours is
      to go die out there. Go on, I sense Milo coming, and my arms are tired."
